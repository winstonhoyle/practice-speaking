<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to cloud backup or to a new phone during setup. The API key couldn't be
     decrypted there anyway (its Keystore key stays on this phone), and sessions stay on the phone they were made on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
