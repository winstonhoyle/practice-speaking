root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# Wrap a signature only when it doesn't fit on one line.
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = unset
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = unset
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The theme's own CompositionLocals.
compose_allowed_composition_locals = LocalPsExtendedColors,LocalPsShapes,LocalPsSpacing,LocalPsSizes

[*.md]
trim_trailing_whitespace = false
